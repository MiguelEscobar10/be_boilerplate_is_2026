// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  notifications Notification[]
  listings      Listing[]

  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// Aviso informativo para un usuario (H10). Lo registra el servicio de avisos
// (H20) y se consulta desde la bandeja. Ver docs/modulos/notificaciones.md.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // TEXT hasta DB-20.1, que lo convierte al enum ModuloOrigen y agrega los
  // límites de largo de title (1-100) y message (1-500).
  sourceModule String @map("source_module")
  title        String
  // Sin datos sensibles: nunca números de tarjeta, códigos ni contraseñas.
  message      String

  // Referencia opcional a la entidad que originó el aviso (p. ej. una reserva).
  // TEXT para no atarla al tipo de clave de ningún módulo.
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")

  // null = pendiente de lectura. Es el único campo que cambia después de crear
  // el aviso, por eso no hay updated_at.
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Bandeja de un usuario: pendientes (read_at IS NULL) y más recientes primero.
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

// Tipo de bien que se publica en el catálogo (H01).
enum ListingType {
  EQUIPO
  ESPACIO
}

// Unidad en la que se cobra la tarifa de una publicación.
enum RateUnit {
  HORA
  DIA
  NOCHE
  SEMANA
}

// Equipo o espacio publicado por un arrendador (H01). Ver docs/modulos/catalogo.md.
model Listing {
  id String @id @default(uuid()) @db.Uuid

  // Dueño de la publicación. RESTRICT: más adelante las reservas cuelgan de
  // la publicación, así que no se borra junto con el usuario.
  landlordId String @map("landlord_id") @db.Uuid
  landlord   User   @relation(fields: [landlordId], references: [id], onDelete: Restrict)

  type        ListingType
  name        String      @db.VarChar(100)
  description String?     @db.VarChar(1000)
  location    String      @db.VarChar(200)

  // Montos con dos decimales. Los CHECK (tarifa > 0, depósito >= 0) están
  // en la migración porque Prisma no los modela.
  rateAmount    Decimal  @map("rate_amount") @db.Decimal(12, 2)
  rateUnit      RateUnit @map("rate_unit")
  depositAmount Decimal  @default(0) @map("deposit_amount") @db.Decimal(12, 2)

  conditions String?  @db.VarChar(1000)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  images ListingImage[]

  @@index([landlordId])
  @@map("listings")
}

// Foto de una publicación, en el orden en que se muestra.
model ListingImage {
  id String @id @default(uuid()) @db.Uuid

  listingId String  @map("listing_id") @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Ruta privada en el almacenamiento o URL pública de la imagen.
  path      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([listingId, position])
  @@map("listing_images")
}
