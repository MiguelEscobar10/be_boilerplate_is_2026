// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  // Rol de la cuenta (Módulo 0). Lo fija el registro; REVISOR solo por seed.
  role         UserRole @default(ARRENDATARIO)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  notifications Notification[]
  listings      Listing[]
  profile       UserProfile?
  reservations  Reservation[]

  conversationsAsTenant   Conversation[] @relation("ConversationTenant")
  conversationsAsLandlord Conversation[] @relation("ConversationLandlord")
  messages                Message[]
  registeredDeliveries    Delivery[]

  identityVerifications         IdentityVerification[] @relation("IdentityVerificationUser")
  reviewedIdentityVerifications IdentityVerification[] @relation("IdentityVerificationReviewer")

  // Calificaciones del bien y del arrendador (DB-17.1): las que escribió como
  // arrendatario y las que recibió como arrendador.
  listingRatingsWritten  ListingLandlordRating[] @relation("ListingRatingAuthor")
  listingRatingsReceived ListingLandlordRating[] @relation("ListingRatingLandlord")

  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// Módulo del proyecto que origina un aviso (DB-20.1). Un valor por módulo.
enum ModuloOrigen {
  CATALOGO
  BUSQUEDA
  RESERVAS
  PAGOS_GARANTIA
  MENSAJERIA
  RESENAS
  VERIFICACION
  NOTIFICACIONES
  REPORTES
}

// Aviso informativo para un usuario (H10). Lo registra el servicio de avisos
// (H20) y se consulta desde la bandeja. Ver docs/modulos/notificaciones.md.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceModule ModuloOrigen @map("source_module")
  // CHECK notifications_title_length_check (escrito a mano en la migración de
  // DB-20.1): al menos 1 carácter que no sea espacio y como máximo 100 en
  // total, contando los espacios.
  title        String
  // CHECK notifications_message_length_check: al menos 1 carácter que no sea
  // espacio y como máximo 500 en total, contando los espacios.
  // Sin datos sensibles: nunca números de tarjeta, códigos ni contraseñas.
  message      String

  // Referencia opcional a la entidad que originó el aviso (p. ej. una reserva).
  // TEXT para no atarla al tipo de clave de ningún módulo.
  // CHECK notifications_reference_pair_check: van las dos o ninguna.
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")

  // null = pendiente de lectura. Es el único campo que cambia después de crear
  // el aviso, por eso no hay updated_at.
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Bandeja de un usuario: pendientes (read_at IS NULL) y más recientes primero.
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

// Tipo de bien que se publica en el catálogo (H01).
enum ListingType {
  EQUIPO
  ESPACIO
}

// Unidad en la que se cobra la tarifa de una publicación.
enum RateUnit {
  HORA
  DIA
  NOCHE
  SEMANA
}

// Equipo o espacio publicado por un arrendador (H01). Ver docs/modulos/catalogo.md.
model Listing {
  id String @id @default(uuid()) @db.Uuid

  // Dueño de la publicación. RESTRICT: más adelante las reservas cuelgan de
  // la publicación, así que no se borra junto con el usuario.
  landlordId String @map("landlord_id") @db.Uuid
  landlord   User   @relation(fields: [landlordId], references: [id], onDelete: Restrict)

  type        ListingType
  name        String      @db.VarChar(100)
  description String?     @db.VarChar(1000)
  location    String      @db.VarChar(200)

  // Montos con dos decimales. Los CHECK (tarifa > 0, depósito >= 0) están
  // en la migración porque Prisma no los modela.
  rateAmount    Decimal  @map("rate_amount") @db.Decimal(12, 2)
  rateUnit      RateUnit @map("rate_unit")
  depositAmount Decimal  @default(0) @map("deposit_amount") @db.Decimal(12, 2)

  conditions String?  @db.VarChar(1000)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  // Si es true, solo la pueden solicitar arrendatarios con una verificación de
  // identidad APROBADA (H19, DB-19.1). La decide el dueño. No se guarda en
  // `users` si alguien está verificado: se consulta en identity_verifications.
  requiresVerification Boolean @default(false) @map("requires_verification")

  images             ListingImage[]
  conversations      Conversation[]
  reservations       Reservation[]
  availabilityBlocks AvailabilityBlock[]
  // Calificaciones que recibió el bien (DB-17.1), para su promedio.
  ratings            ListingLandlordRating[]

  @@index([landlordId])
  @@map("listings")
}

// Foto de una publicación, en el orden en que se muestra.
model ListingImage {
  id String @id @default(uuid()) @db.Uuid

  listingId String  @map("listing_id") @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Ruta privada en el almacenamiento o URL pública de la imagen.
  path      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([listingId, position])
  @@map("listing_images")
}

// Conversación entre arrendatario y arrendador sobre una publicación (H15).
// La misma tabla sirve para la conversación de una reserva (H16, DB-16.1).
// Ver docs/modulos/mensajeria.md.
model Conversation {
  id String @id @default(uuid()) @db.Uuid

  listingId String  @map("listing_id") @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  tenantId String @map("tenant_id") @db.Uuid
  tenant   User   @relation("ConversationTenant", fields: [tenantId], references: [id], onDelete: Restrict)

  landlordId String @map("landlord_id") @db.Uuid
  landlord   User   @relation("ConversationLandlord", fields: [landlordId], references: [id], onDelete: Restrict)

  // NULL = conversación previa a la reserva (H15). La FK a reservations la
  // agrega DB-16.1 cuando exista la tabla de reservas (DB-03.1).
  reservationId String? @map("reservation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  messages Message[]

  // Índice único parcial (listing_id, tenant_id) WHERE reservation_id IS NULL
  // y CHECK tenant_id <> landlord_id: escritos a mano en la migración.
  @@index([tenantId])
  @@index([landlordId])
  @@map("conversations")
}

// Mensaje dentro de una conversación (H15, H16).
model Message {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorId String @map("author_id") @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  // CHECK: al menos 1 carácter sin contar espacios de los extremos.
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")

  // Historial en orden cronológico; id desempata mensajes del mismo instante.
  @@index([conversationId, createdAt, id])
  @@map("messages")
}

// Roles del sistema (sección 2.1). ARRENDADOR y ARRENDATARIO se registran
// solos; REVISOR revisa documentos de identidad (H07) y solo lo crea el seed.
enum UserRole {
  ARRENDADOR
  ARRENDATARIO
  REVISOR
}

// Datos personales de la cuenta. Separado de `users` para tocar lo menos
// posible la tabla de la cátedra. Ver docs/modulos/cuentas.md.
model UserProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String @db.VarChar(100)
  // Solo dígitos, de 8 a 15 (CHECK en la migración).
  phone String @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

// Estados de una reserva (sección 2.3 del documento de historias). Los valores
// se quedan en español porque son los mismos que viajan en la API (`estado`).
// CANCELADA está previsto en el modelo, pero ninguna historia lo produce.
enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
  CANCELADA
  EN_CURSO
  COMPLETADA
}

// Solicitud de alquiler de una publicación para un período (H03). Una solicitud
// PENDIENTE no ocupa fechas; CONFIRMADA y EN_CURSO sí. Ver docs/modulos/reservas.md.
model Reservation {
  id String @id @default(uuid()) @db.Uuid

  // RESTRICT en las dos claves: la reserva es un registro del alquiler (pagos,
  // garantía, mensajes y calificaciones cuelgan de ella) y no debe desaparecer
  // si se borra la publicación o el arrendatario.
  listingId String  @map("listing_id") @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  tenantId String @map("tenant_id") @db.Uuid
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Período solicitado, en UTC. El CHECK reservations_period_check exige
  // start_at < end_at (la migración lo agrega porque Prisma no modela CHECK).
  startAt DateTime          @map("start_at")
  endAt   DateTime          @map("end_at")
  status  ReservationStatus @default(PENDIENTE)

  // Fotografía del precio al reservar: costo del alquiler y depósito, con dos
  // decimales y sin valor por defecto, para que el servicio los copie siempre.
  // CHECK >= 0 en la migración.
  rentalCost    Decimal @map("rental_cost") @db.Decimal(12, 2)
  depositAmount Decimal @map("deposit_amount") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  simulatedPayments     SimulatedPayment[]
  delivery              Delivery?
  // Calificación del bien y del arrendador de esta reserva (H17, DB-17.1).
  listingLandlordRating ListingLandlordRating?

  // Búsqueda de solapamientos: reservas CONFIRMADA o EN_CURSO de una
  // publicación que se cruzan con un rango.
  @@index([listingId, status, startAt, endAt])
  @@map("reservations")
}

// Período en el que el arrendador marca una publicación como no disponible
// (H14). DB-14.1 completa la tabla con `created_by`, `created_at` y el índice
// de traslapes. Ver docs/modulos/reservas.md.
model AvailabilityBlock {
  id String @id @default(uuid()) @db.Uuid

  // CASCADE: un bloqueo no tiene sentido sin su publicación.
  listingId String  @map("listing_id") @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Período bloqueado, en UTC. CHECK start_at < end_at en la migración.
  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")
  reason  String?  @db.VarChar(200)

  @@map("availability_blocks")
}

// Estados de un intento de pago simulado (H05). En español, como el `estado`
// que viaja en la API.
enum SimulatedPaymentStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Intento de pago simulado de una reserva (H05, H06). Cada intento es una fila
// nueva: los rechazados no se sobrescriben. Ver docs/modulos/pagos.md.
//
// No hay columnas para el número completo de la tarjeta ni para el código de
// seguridad: solo se guardan los últimos 4 dígitos.
model SimulatedPayment {
  id String @id @default(uuid()) @db.Uuid

  // RESTRICT: el pago es un registro financiero y no desaparece con la reserva.
  reservationId String      @map("reservation_id") @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  // Importes con dos decimales. CHECK >= 0 en cada uno y
  // total_amount = rental_cost + deposit_amount, en la migración.
  totalAmount   Decimal @map("total_amount") @db.Decimal(12, 2)
  rentalCost    Decimal @map("rental_cost") @db.Decimal(12, 2)
  depositAmount Decimal @map("deposit_amount") @db.Decimal(12, 2)

  status SimulatedPaymentStatus @default(PENDIENTE)

  // CHECK: exactamente 4 dígitos.
  cardLast4       String  @map("card_last4") @db.Char(4)
  // CHECK: si RECHAZADO, obligatorio y con algún carácter que no sea espacio
  // en blanco (~ '\S'); NULL en los demás estados.
  rejectionReason String? @map("rejection_reason") @db.VarChar(200)
  // CHECK: de 1 a 3. Único por reserva.
  attemptNumber   Int     @map("attempt_number")

  createdAt DateTime @default(now()) @map("created_at")

  // Índice único parcial (reservation_id) WHERE status = 'APROBADO': escrito a
  // mano en la migración.
  @@unique([reservationId, attemptNumber])
  // Historial de intentos de una reserva, más recientes primero.
  @@index([reservationId, createdAt(sort: Desc), id(sort: Desc)])
  // Pagos por estado en un rango de created_at, para consultas que no pasen
  // por un arrendador (DB-21.1). listing_income() no lo usa: llega a los
  // pagos por reserva con simulated_payments_one_approved_per_reservation_key.
  @@index([status, createdAt])
  @@map("simulated_payments")
}

// Estados de una solicitud de verificación de identidad (sección 2.3 del
// documento de historias). En español, como el `estado` que viaja en la API.
enum IdentityVerificationStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Solicitud de verificación de identidad de un arrendatario (H07). Cada envío
// es una fila nueva: una RECHAZADA no se reabre, se envía otra. Una persona está
// verificada si tiene alguna en APROBADA (H19). Ver docs/modulos/verificacion.md.
model IdentityVerification {
  id String @id @default(uuid()) @db.Uuid

  // CASCADE: el documento es un dato personal del usuario y no tiene sentido
  // conservarlo si se borra su cuenta.
  userId String @map("user_id") @db.Uuid
  user   User   @relation("IdentityVerificationUser", fields: [userId], references: [id], onDelete: Cascade)

  // Ruta privada del documento en el almacenamiento (no es una URL pública).
  // Solo la lee el servicio para entregárselo al REVISOR por una ruta protegida
  // (BE-07.2); ningún endpoint público la devuelve.
  // CHECK: al menos un carácter que no sea espacio en blanco.
  documentKey String @map("document_key") @db.VarChar(255)

  status IdentityVerificationStatus @default(PENDIENTE)

  // Motivo opcional que escribe el REVISOR al rechazar. CHECK: solo en
  // RECHAZADA y, si viene, con algún carácter que no sea espacio en blanco.
  rejectionReason String? @map("rejection_reason") @db.VarChar(500)

  // Quién decidió y cuándo. CHECK: ambos NULL mientras está PENDIENTE y ambos
  // presentes en APROBADA o RECHAZADA. RESTRICT: la decisión es un registro y
  // no pierde a su revisor.
  reviewedById String?   @map("reviewed_by") @db.Uuid
  reviewedBy   User?     @relation("IdentityVerificationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt   DateTime? @map("reviewed_at")

  submittedAt DateTime @default(now()) @map("submitted_at")

  // Índice único parcial (user_id) WHERE status = 'PENDIENTE' (una sola
  // solicitud pendiente por usuario): escrito a mano en la migración.

  // Solicitudes de un usuario, más recientes primero (la "última" de BE-07.1).
  @@index([userId, submittedAt(sort: Desc)])
  // Cola del REVISOR: solicitudes PENDIENTE en orden de llegada (BE-07.2).
  @@index([status, submittedAt])
  @@map("identity_verifications")
}

// Entrega del equipo o inicio del uso del espacio (H08). Deja constancia de
// cuándo empezó el alquiler y en qué estado estaba el bien. Ver
// docs/modulos/entregas.md.
model Delivery {
  id String @id @default(uuid()) @db.Uuid

  // Una sola entrega por reserva (UNIQUE). RESTRICT: la entrega es parte del
  // registro del alquiler y no desaparece con la reserva.
  reservationId String      @unique @map("reservation_id") @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  // Fecha y hora real de la entrega, en UTC. La pone el servidor (BE-08.1).
  deliveredAt DateTime @default(now()) @map("delivered_at")

  // Estado del bien al entregarlo. Obligatoria, hasta 500 caracteres.
  // CHECK: al menos un carácter que no sea espacio en blanco.
  initialConditionNote String @map("initial_condition_note") @db.VarChar(500)

  // Arrendador que registró la entrega. RESTRICT, como en las reservas.
  registeredById String @map("registered_by") @db.Uuid
  registeredBy   User   @relation(fields: [registeredById], references: [id], onDelete: Restrict)

  photos DeliveryPhoto[]

  @@index([registeredById])
  @@map("deliveries")
}

// Foto opcional del estado inicial (máximo 5 por entrega, posiciones 0 a 4).
model DeliveryPhoto {
  id String @id @default(uuid()) @db.Uuid

  // CASCADE: una foto no tiene sentido sin su entrega.
  deliveryId String   @map("delivery_id") @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  // Ruta privada en el almacenamiento (como las fotos de publicaciones).
  // CHECK: no vacía.
  path      String
  // CHECK: de 0 a 4, así no caben más de 5 por entrega junto con el único.
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([deliveryId, position])
  @@map("delivery_photos")
}

// Calificación que el arrendatario le da al bien y a su arrendador al terminar
// una reserva COMPLETADA (H17). Una sola por reserva. Ver
// docs/modulos/resenas.md.
model ListingLandlordRating {
  id String @id @default(uuid()) @db.Uuid

  // UNIQUE: una reserva se califica una sola vez. RESTRICT, como todo lo que
  // cuelga de la reserva.
  reservationId String      @unique @map("reservation_id") @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  // Arrendatario que califica (el de la reserva).
  authorId String @map("author_id") @db.Uuid
  author   User   @relation("ListingRatingAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  // Publicación y arrendador calificados. Se guardan aquí, además de en la
  // reserva, para promediar por publicación y por arrendador sin pasar por las
  // reservas. El trigger listing_landlord_ratings_consistency (a mano en la
  // migración) exige que coincidan con los de la reserva.
  listingId String  @map("listing_id") @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  landlordId String @map("landlord_id") @db.Uuid
  landlord   User   @relation("ListingRatingLandlord", fields: [landlordId], references: [id], onDelete: Restrict)

  // CHECK listing_landlord_ratings_listing_score_check y
  // listing_landlord_ratings_landlord_score_check (a mano en la migración): de
  // 1 a 5 cada uno.
  listingScore  Int @map("listing_score") @db.SmallInt
  landlordScore Int @map("landlord_score") @db.SmallInt

  // CHECK listing_landlord_ratings_comment_check: si viene, con algún carácter
  // que no sea espacio en blanco.
  comment String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  // Promedio del bien y del arrendador.
  @@index([listingId])
  @@index([landlordId])
  @@map("listing_landlord_ratings")
}
