# Variables de la demo (docker-compose.demo.yml). Copiar a .env.demo y cambiar
# TODOS los valores de ejemplo antes de publicarla. .env.demo no se sube al repo.

POSTGRES_USER=mp4
# Solo letras y números: va dentro de DATABASE_URL sin codificar, y un /, + o =
# la deja inválida. Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=cambiar-por-una-contrasena-larga
POSTGRES_DB=mp4_demo

# 32 caracteres o más. Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Una cuenta por rol que crea el seed. Obligatorias en producción.
SEED_LANDLORD_EMAIL=arrendador@ejemplo.com
SEED_LANDLORD_PASSWORD=cambiar-esta-contrasena
SEED_TENANT_EMAIL=arrendatario@ejemplo.com
SEED_TENANT_PASSWORD=cambiar-esta-contrasena
SEED_REVIEWER_EMAIL=revisor@ejemplo.com
SEED_REVIEWER_PASSWORD=cambiar-esta-contrasena

# Puertos publicados en la máquina.
API_PORT=3000
WEB_PORT=8080

# Carpeta del repositorio del frontend, relativa a este archivo.
FRONTEND_DIR=../fe_boilerplate_is_2026
